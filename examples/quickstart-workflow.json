        "jsCode": "const j = $json; const emails = j.Emails ?? j.emails ?? j.Email ?? j.email ?? []; const email = Array.isArray(emails) ? (emails[0] ?? '') : emails; const domain = j.Domain ?? j.domain ?? j.Website ?? j.website ?? ''; return { json: { ...j, domain, primaryEmail: email, outreachStatus: email ? 'ready' : 'needs_contact', suggestedNextStep: email ? 'personalize outreach' : 'enrich contact' } };"
