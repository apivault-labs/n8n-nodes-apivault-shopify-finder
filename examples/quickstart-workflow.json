      "parameters": {
        "content": "## Setup\n1. Select your Apify API credential.\n2. Adjust platform, country and audience filters.\n3. Run the 50-row sample.\n4. Review the results before increasing the limit.\n5. Connect the final output to your CRM, Google Sheets or review queue.",
        "height": 260,
        "width": 440
      },
      "id": "ef9bab2a-78a5-57ae-afd9-aa863f2c0b72",
      "name": "How to use this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -220
      ]
    },
    {
      "parameters": {
        "workflow": "export",
        "platforms": "shopify_sites,woocommerce_sites",
        "outputPreset": "traffic",
        "hasEmail": true,
        "onlyWithTrafficData": true,
        "minMonthlyVisits": 10000,
        "dedupeByDomain": true,
        "maxItems": 50
      },
      "id": "e45acbb3-67a1-5be7-9dd3-dbd655838a86",
      "name": "Find qualified websites with Apify",
      "type": "n8n-nodes-apivault-shopify-finder.shopifyFinder",
      "typeVersion": 1,
      "position": [
        260,
        120
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json; const first = (value) => Array.isArray(value) ? (value[0] ?? '') : (typeof value === 'string' ? (value.split(',')[0] ?? '').trim() : (value ?? '')); const email = first(j.Emails ?? j.emails ?? j.Email ?? j.email); const phone = first(j.Telephones ?? j.telephones ?? j.Phone ?? j.phone); const domain = j['Root Domain'] ?? j.Domain ?? j.domain ?? j.Website ?? j.website ?? ''; return { json: { ...j, domain, primaryEmail: email, primaryPhone: phone, monthlyVisits: j['Monthly Visits'] ?? null, outreachStatus: email || phone ? 'ready_for_review' : 'needs_contact', suggestedNextStep: email || phone ? 'review and personalize' : 'enrich contact' } };"
      },
